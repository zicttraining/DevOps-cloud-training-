{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ZiCloudTechTrainingServices",
      "Effect": "Allow",
      "Action": [
        "budgets:*",
        "cloudwatch:*",
        "ec2:*",
        "elasticloadbalancing:*",
        "logs:*",
        "rds:*",
        "route53:GetHostedZone",
        "route53:ListHostedZones",
        "route53:ListResourceRecordSets",
        "route53:ChangeResourceRecordSets",
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:GetBucket*",
        "s3:ListBucket",
        "s3:PutBucket*",
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "sns:*",
        "ssm:GetParameter",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    }
  ]
}
